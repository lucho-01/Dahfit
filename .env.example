# Plantilla de configuración local. Copiar a .env y rellenar.
# .env está ignorado por git; este archivo sí se versiona.

DATABASE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

DAFIT_RANK_SCALE=SPEC_V1

# Seguridad: dejar en false hasta que el frontend integre el login.
# Al pasar a true, DAFIT_JWT_SECRET es obligatorio (minimo 32 bytes).
DAFIT_SECURITY_ENABLED=false
DAFIT_JWT_SECRET=
